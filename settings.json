{
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "enabledModels": [
    "openai-codex/gpt-6-astra:medium",
    "opencode-go/deepseek-flash:high"
  ],
  "packages": [
    "npm:@houndmcp/hound-mcp-pi",
    "npm:@99percentpeople/pi-codex-api",
    "npm:@ogulcancelik/pi-codex-compaction",
    "npm:@senad-d/drawme",
    "npm:@pi-unipi/btw",
    "npm:@plannotator/pi-extension",
    "npm:@mobrienv/pi-tidy-tools",
    "npm:@mobrienv/pi-tidy-subagents",
    "git:github.com/kkunkunya/pi-chrome"
  ],
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "outputPad": 1,
  "compaction": {
