{
  "lastChangelogVersion": "0.99.1",
  "quietStartup": true,
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "enabledModels": [
    "openai-codex/gpt-6-astra:medium",
    "opencode-go/deepseek-v4.1-flash:high",
    "openai-codex/gpt-6-luna:low"
  ],
  "packages": [
    "npm:@99percentpeople/pi-codex-api",
    "npm:@ogulcancelik/pi-codex-compaction",
    "npm:@senad-d/drawme",
    "npm:@plannotator/pi-extension",
    "git:github.com/kkunkunya/pi-chrome",
    "npm:pi-cc-extensions",
    "npm:pi-btw"
  ],
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "outputPad": 1,
