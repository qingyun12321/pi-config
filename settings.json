{
  "lastChangelogVersion": "0.84.1",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-5.6-sol:high",
    "opencode-go/deepseek-v4-flash:high"
  ],
  "packages": [
    {
      "source": "npm:@ff-labs/pi-fff",
      "extensions": []
    },
    "npm:@mobrienv/pi-tidy-tools",
    "npm:@houndmcp/hound-mcp-pi",
    "npm:@ogulcancelik/pi-herdr",
    "npm:@narumitw/pi-btw",
    "npm:@99percentpeople/pi-codex-api",
    "npm:@ogulcancelik/pi-codex-compaction",
    "git:github.com/edxeth/pi-subagents"
  ],
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "outputPad": 1,
  "compaction": {
    "enabled": true
  },
  "retry": {
    "enabled": true
  }
